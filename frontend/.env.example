# Frontend environment for EduFusion
# Copy this file to .env.local and fill in your own values.
# These NEXT_PUBLIC_* values are public (baked into the browser bundle) —
# never put secret keys here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1